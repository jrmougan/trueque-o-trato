# ===========================================
# Trueque o Trato - Environment Variables
# ===========================================
# `mise run setup` crea .env a partir de este fichero con puertos, nombre de
# proyecto Compose y secretos propios de cada checkout/worktree (nunca lo
# sobrescribe). Los valores de abajo sirven para el docker-compose.yml clásico.

# App (puerto de `next dev`) y proyecto Compose local (compose.dev.yaml)
PORT=3000
COMPOSE_PROJECT_NAME=trueque-local

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trueque_o_trato
DATABASE_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trueque_o_trato?schema=public"

# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# App URL
NEXTAUTH_URL="http://localhost:3000"

# MinIO / S3
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="trueque-images"
S3_REGION="us-east-1"
# Public URL prefix for images (browser-accessible)
S3_PUBLIC_URL="http://localhost:9000/trueque-images"
